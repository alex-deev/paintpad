{
  "name": "paintpad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "browser:deps": "bash scripts/install-browser-deps.sh",
    "test:e2e": "bash -c 'source scripts/browser-env.sh && playwright test'",
    "test:e2e:update": "bash -c 'source scripts/browser-env.sh && playwright test --update-snapshots'",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
